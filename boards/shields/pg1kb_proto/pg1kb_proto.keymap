#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC         &none                              &none      &none  &mkp MCLK  &mkp LCLK                         &mkp RCLK  &none
&kp TAB         &kp Q  &kp W         &kp E         &kp R      &kp T  &kp Y      &kp U      &kp I      &kp O       &kp P      &kp EQUAL
&kp LCTRL       &kp A  &kp S         &kp D         &kp F      &kp G  &kp H      &kp J      &kp K      &kp L       &kp N      &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Z  &kp X         &kp C         &kp V      &kp N  &kp N      &kp M      &kp COMMA  &kp PERIOD  &kp SLASH  &kp BACKSLASH
                       &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE  &none  &none      &kp ENTER  &none      &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans                  &trans  &trans  &trans  &trans                  &trans  &trans
&none   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
